  <contact>
    <!-- P7v3 arm adjacent-link excludes. -->
    <exclude body1="arm_base_link" body2="link1"/>
    <exclude body1="arm_base_link" body2="link2"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="link6"/>
    <exclude body1="link6" body2="link7"/>
    <!-- link5/link6/link7 share one origin (wrist YAW + PITCH, joint5 ROLL
         frozen): link5 and link7 are effectively adjacent through the
         zero-length link6, so exclude their self-collision (mirrors
         arm_base_link<->link2 through bare link1). -->
    <exclude body1="link5" body2="link7"/>
    <exclude body1="link7" body2="tool"/>
    <exclude body1="tool" body2="end_link"/>
    <exclude body1="tool" body2="umi_base_link"/>
    <!-- arm_base_link vs. far wrist/gripper: with joint3+joint5 frozen the
         kinematic chain from arm_base_link to link5/6/7/umi_base_link is
         shorter (2 fewer intervening DOF than a2arm_v2), so certain
         joint1/2/4/6/7 combinations swing the wrist/gripper back close to
         arm_base_link (a self-collision that does not occur in the
         6-DOF joint7-frozen a2arm_v2 sibling). Found via 500-sample random
         soft-limit sweep (see self-collision audit); excluded here as the
         kinematically expected outcome of the shorter chain, not a bug. -->
    <exclude body1="arm_base_link" body2="link5"/>
    <exclude body1="arm_base_link" body2="link6"/>
    <exclude body1="arm_base_link" body2="link7"/>
    <exclude body1="arm_base_link" body2="umi_base_link"/>
    <!-- Arm vs. near legs. -->
    <exclude body1="arm_base_link" body2="FL_hip"/>
    <exclude body1="arm_base_link" body2="FR_hip"/>
    <exclude body1="arm_base_link" body2="RL_hip"/>
    <exclude body1="arm_base_link" body2="RR_hip"/>
    <exclude body1="link1" body2="FL_hip"/>
    <exclude body1="link1" body2="FR_hip"/>
    <exclude body1="link1" body2="RL_hip"/>
    <exclude body1="link1" body2="RR_hip"/>
    <!-- UMI internal (welded linkage self-collision). -->
    <exclude body1="umi_base_link" body2="umi_claw"/>
    <exclude body1="umi_claw" body2="umi_l11"/>
    <exclude body1="umi_claw" body2="umi_l61"/>
    <exclude body1="umi_claw" body2="umi_l21"/>
    <exclude body1="umi_claw" body2="umi_l31"/>
    <exclude body1="umi_claw" body2="umi_l41"/>
    <exclude body1="umi_claw" body2="umi_l51"/>
