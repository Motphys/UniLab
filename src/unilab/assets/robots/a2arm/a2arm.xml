<mujoco model="a2arm">
  <!-- A2 quadruped + P7v3 (7-DOF, joint3+joint5 frozen) arm + UMI gripper v3.
       SIBLING of a2arm_v2.xml: SAME A2 hardware and SAME P7v3+UMI meshes; the
       difference is which arm joints are frozen to reach the 5-DOF this task
       uses (NUM_ARM=5).

       a2arm_v2    freezes joint7 (wrist PITCH) -> cripples the spherical wrist.
       a2arm_v2_j3 freezes joint3 (upper-arm ROLL, the redundant 7th DOF) AND
       joint5 (wrist ROLL) -> leaves a 5-DOF arm: 3 positioning (joint1 YAW +
       joint2 PITCH + joint4 PITCH) + 2 wrist (joint6 YAW + joint7 PITCH);
       joint3+joint5 frozen. Verified (q=0 world-axis classification +
       multi-restart IK): improves lower-mid front reachability vs the
       joint7-frozen variant.

       Active arm joints (tree/qpos/actuator order): joint1,2,4,6,7.
       joint3 and joint5 have NO <joint> (link3/link5 rigid on their parent
       at the frozen 0 rad).
       Legs / base / IMU / foot geoms + full sensor suite mirror the Go2/A2
       pos-force sensor/geom/ordering contract VERBATIM (identical to a2arm_v2):
         - foot collision geoms FL,FR,RL,RR (+ foot sites FL..RR)
         - thigh/calf collision geoms fl_thigh_0, fl_calf_0/1, ... (undesired-contact)
         - base collision geoms base1/base2/base3
         - IMU sensors (local_linvel, gyro, upvector, ...)
         - foot framepos/framelinvel + thigh framepos sensors
       Arm mounted at arm_base_link=(0.0625,0,0.1209) rel. base_link. armbasepoint
       site is the sphere-frame origin; endpoint site is the TCP at end_link.
       Meshes are SHARED from the a2arm_v2 asset dir (no duplication). Keyframe
       lives in scene_pos_force.xml (task/scene level), per the asset contract. -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option gravity="0 0 -9.81"/>

  <default>
    <default class="hip_joint">
      <joint damping="0.2" armature="0.03" frictionloss="1.0"/>
    </default>
    <default class="thigh_joint">
      <joint damping="0.2" armature="0.03" frictionloss="1.0"/>
    </default>
    <default class="calf_joint">
      <joint damping="1.0" armature="0.03" frictionloss="3.0"/>
    </default>
    <default class="collision">
      <geom group="3" priority="1" condim="6"/>
    </default>
    <default class="foot">
      <geom group="3" priority="1" condim="6"/>
    </default>
    <default class="obj_visual">
      <geom group="2" type="mesh" contype="0" conaffinity="0"/>
    </default>
    <default class="obj_collision">
      <geom group="3" contype="1" conaffinity="1"/>
    </default>
    <!-- P7v3 arm joints: light damping, modest armature (5-DOF articulated). -->
    <default class="p7_arm">
      <joint axis="0 0 1" armature="0.01" damping="0.5" frictionloss="1"/>
    </default>
  </default>

