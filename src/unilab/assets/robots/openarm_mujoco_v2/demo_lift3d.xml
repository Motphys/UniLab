<!--
  Graspability-tuned scene (lift3d variants point here via env.scene.model_file):
    * cube 0.04 m -> 0.03 m (half-size 0.015) so the parallel jaws can fully close around it,
    * higher cube friction (sliding 2.0, torsional 0.5, rolling 0.05) to resist slip on carry,
    * remove the static black_frame distractor under the gripper home.
  Everything else matches demo.xml; the "home" keyframe is inherited from the attached cell model.
-->

<mujoco model="openarm_bimanual cell demo (lift3d)">
  <visual>
    <global offwidth="960" offheight="600"/>
  </visual>

  <asset>
    <model name="cell" file="cell.xml"/>
  </asset>
  <worldbody>
    <attach model="cell" prefix=""/>

    <body name="orange_cube" pos="0.45 0.0 1.05">
      <freejoint/>
      <geom type="box" size="0.015 0.015 0.015" rgba="1.0 0.4 0.0 1"
            mass="0.04" friction="2.0 0.5 0.05" contype="1" conaffinity="1"/>
    </body>
  </worldbody>

</mujoco>
