    <contact name="right_foot_contact_0" geom1="floor" geom2="right_foot_contact_0_geom"
      data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_1" geom1="floor" geom2="right_foot_contact_1_geom"
      data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_2" geom1="floor" geom2="right_foot_contact_2_geom"
      data="found" num="1" reduce="mindist"/>
    <contact name="right_foot_contact_3" geom1="floor" geom2="right_foot_contact_3_geom"
      data="found" num="1" reduce="mindist"/>
  </sensor>

  <keyframe>
    <key name="stand"
      qpos="
      0 0 1.0165
      1 0 0 0
      -0.06 0 0 0.12 -0.06 0
      -0.06 0 0 0.12 -0.06 0
