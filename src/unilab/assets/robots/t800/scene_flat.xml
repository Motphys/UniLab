  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.55 0.57" rgb2="0.55 0.55 0.57"
      width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker"
      rgb1="0.62 0.62 0.63" rgb2="0.49 0.49 0.51"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="1.25 1.25" reflectance="0.0"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <sensor>
    <contact name="left_foot_contact_0" geom1="floor" geom2="left_foot_contact_0_geom"
